 ##################################################################
+##..............repair broken packages............................
+repair_broken_packages()
+{
+	if ! apt-get check >/dev/null 2>&1; then
+		echo "Detected broken package dependencies. Repairing apt state..."
+		run "DEBIAN_FRONTEND=noninteractive apt-get install -f -y --allow-downgrades"
+		run "apt-get check"
+	fi
+}
+
+##################################################################
