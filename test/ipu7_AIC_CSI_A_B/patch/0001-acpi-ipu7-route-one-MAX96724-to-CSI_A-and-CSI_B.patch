  *   DES_I2C_BUS            - DES I2C bus path string (e.g. "\\_SB.PC00.I2C1"), used in I2cSerialBusV2
  *   DES_PATH               - Path to DES itself (e.g. "\\_SB.PC00.DESx"), used in GpioIo
@@ -59,6 +61,21 @@ Name (_CRS, ResourceTemplate () // _CRS: Current Resource Settings
         ,                       // DescriptorName
         )                       // VendorData
 
+#ifdef DES_INTERNAL_PHY_2
+    // Optional second DES output to a second IPU0 MIPI port (dual CSI from
+    // one DES). Which GMSL links go to which output is selected by the DES
+    // subdev routing (media-ctl -R), not by ASL.
+    CSI2Bus(
+        DeviceInitiated,        // SlaveMode
+        DES_PHY_TYPE,           // PhyType (same as the first output)
+        DES_INTERNAL_PHY_2,     // LocalPort (4/5/6/7, must differ from DES_INTERNAL_PHY)
+        "\\_SB.PC00.IPU0",      // ResourceSource
+        DES_TO_MIPI_PORT_2,     // ResourceSourceIndex (IPU0 PRTx of the second output)
+        ,                       // ResourceUsage
+        ,                       // DescriptorName
+        )                       // VendorData
+#endif
+
     I2cSerialBusV2 (
         DES_I2C_ADDR,           // SlaveAddress (e.g. 0x0027 based on Deserializer Hardware)
         ControllerInitiated,    // SlaveMode
