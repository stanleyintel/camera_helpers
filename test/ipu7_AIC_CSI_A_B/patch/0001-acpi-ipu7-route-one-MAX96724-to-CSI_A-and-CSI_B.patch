     fi
-    if [ -n "${CSI2_PAD_OWNER[${d}_${pad}]:-}" ]; then
+    if [ -n "${CSI2_PAD_OWNER[${okey}_${pad}]:-}" ]; then
         die "${where}: capture node offset ${pad} conflicts with "\
